{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@keyfill/core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["spec/**/*", "examples/**/*", "packages/core/src/**/*", "keyfill.config.ts"]
}
